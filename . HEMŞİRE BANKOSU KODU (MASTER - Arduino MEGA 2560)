#include <LiquidCrystal.h>

LiquidCrystal lcd(12, 11, 5, 4, 3, 2);
#define BTN_ONAY 8
#define HOPARLOR 9

int ates1=0, nabiz1=0;
int ates2=0, nabiz2=0;
bool acil1 = false, acil2 = false;
bool veriGeldi1 = false, veriGeldi2 = false;
bool sesiSustur = false;
unsigned long sonSorgu = 0;
unsigned long baslangicZamani = 0;
unsigned long ekranFlasorZamani = 0;
bool flasorDurumu = false;
int sira = 1;

void setup() {
  Serial1.begin(9600);
  Serial2.begin(9600);
  lcd.begin(20, 4);
  pinMode(BTN_ONAY, INPUT_PULLUP);
  pinMode(HOPARLOR, OUTPUT);

  lcd.print(" HASTA IZLEME");
  lcd.setCursor(0,1); lcd.print("SISTEMI AKTIF");
  delay(1000); lcd.clear();
  lcd.setCursor(0,0); lcd.print("ODA ATES NABIZ");
  lcd.setCursor(0,1); lcd.print("--------------------");
  baslangicZamani = millis();
}

void loop() {
  if (millis() - sonSorgu > 500) {
    sonSorgu = millis();
    while(Serial1.available()) Serial1.read();
    while(Serial2.available()) Serial2.read();
    
    if(sira == 1) {
      Serial1.print('1');
      sira = 2;
    }
    else {
      Serial2.print('2');
      sira = 1;
    }
  }

  if (Serial1.available()) {
    char header = Serial1.read();
    if (header == 'A') acil1 = true;
    else if (header == 'D') {
      Serial1.parseInt();
      int a = Serial1.parseInt(); int n = Serial1.parseInt();
      if(a > 0) { ates1 = a; nabiz1 = n; veriGeldi1 = true; }
    }
  }

  if (Serial2.available()) {
    char header = Serial2.read();
    if (header == 'A') acil2 = true;
    else if (header == 'D') {
      Serial2.parseInt();
      int a = Serial2.parseInt(); int n = Serial2.parseInt();
      if(a > 0) { ates2 = a; nabiz2 = n; veriGeldi2 = true; }
    }
  }

  int durum1 = 0;
  int durum2 = 0;

  if (millis() - baslangicZamani > 5000) {
    if(ates1 >= 38) durum1 = 1;
    else if(nabiz1 > 100) durum1 = 2;
    else if(nabiz1 > 0 && nabiz1 < 60) durum1 = 3;

    if(ates2 >= 38) durum2 = 1;
    else if(nabiz2 > 100) durum2 = 2;
    else if(nabiz2 > 0 && nabiz2 < 60) durum2 = 3;
  }

  if (!acil1 && !acil2 && durum1 == 0 && durum2 == 0) {
    sesiSustur = false;
  }

  if (millis() - ekranFlasorZamani > 500) {
    ekranFlasorZamani = millis();
    flasorDurumu = !flasorDurumu;
  }

  bool kritik = (acil1 || acil2 || durum1 > 0 || durum2 > 0);
  if (kritik && !sesiSustur) {
    tone(HOPARLOR, 1000); delay(50);
    tone(HOPARLOR, 800); delay(50);
  } else {
    noTone(HOPARLOR);
  }

  if(digitalRead(BTN_ONAY) == LOW) {
    sesiSustur = true;
    if(acil1) { Serial1.print("K"); acil1 = false; }
    if(acil2) { Serial2.print("K"); acil2 = false; }
    delay(500);
  }
}
